#!/bin/sh
# OpenCreator plugin manager: oc-plugin list | search [WORD] | install ID|URL | update [ID] | remove ID
#   enable ID | disable ID | sync | logs ID [ITEM]
#   start|stop|restart|status [ID [ITEM]] | boot | moonraker [URL|--find]
# $0 may be a symlink (e.g. /opt/bin/oc-plugin); resolve to the real script so
# HERE is the directory that actually contains oc_plugin.py.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in
        /*) SELF=$LINK ;;
        *)  SELF=$(dirname "$SELF")/$LINK ;;
    esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)
export PATH=$PATH:/opt/bin
for py in /usr/data/python-hf/bin/python3 /usr/data/opencreator/klipper/klippy-env/bin/python python3; do
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$HERE/oc_plugin.py" "$@"
    fi
done
# Tunneled printers from before the installer put python-hf there have only the printer's own
# Python, which needs its own, OpenSSL's and libffi's library folders.
if [ -x /usr/prog/Python-3.8.2/bin/python3 ]; then
    LD_LIBRARY_PATH=/usr/prog/Python-3.8.2/lib:/usr/prog/openssl-1.0.2d/lib:/usr/prog/libffi-3.4.4/lib exec /usr/prog/Python-3.8.2/bin/python3 "$HERE/oc_plugin.py" "$@"
fi
echo "oc-plugin: no Python found" >&2
exit 1
